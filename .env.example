# --- Database ---
# Dev: sqlite, Prod: postgresql
DB_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Prod example: DATABASE_URL="postgresql://user:password@localhost:5432/wac?schema=public"

# --- Security ---
# 32-byte key, base64-encoded, used for AES-256-GCM encryption of stored secrets (access tokens, etc).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Secret used to sign/verify admin sessions if/when an admin web login is added.
ADMIN_SESSION_SECRET=

# --- Meta WhatsApp Cloud API (per-account creds are stored encrypted in DB; these are platform-level) ---
# Tech Provider / Meta App used for Embedded Signup + Graph API calls.
META_APP_ID=
META_APP_SECRET=
# Checked against Meta's Graph API changelog at build time (2026-06): v21.0-v25.0 are all
# supported with no deprecation date set; v25.0 is current/latest. Using v22.0 as a stable
# default with margin before any future deprecation window — bump as needed, no code change required.
META_GRAPH_API_VERSION=v22.0
# Default verify token suggestion for new webhook subscriptions (per-account tokens are stored in DB).
META_WEBHOOK_VERIFY_TOKEN_DEFAULT=

# --- Public REST API ---
API_PORT=3000
API_HOST=0.0.0.0
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# --- Queue / Redis (for bulk broadcast rate limiting, step 7) ---
REDIS_URL=redis://localhost:6379

# --- Logging ---
LOG_LEVEL=info
