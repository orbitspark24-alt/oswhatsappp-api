{
  "name": "whatsapp-reseller-console",
  "version": "0.1.0",
  "description": "Console-driven platform to provision, meter, and bill WhatsApp Business API (Cloud API) accounts for end-clients on a monthly subscription basis.",
  "private": true,
  "type": "commonjs",
  "bin": {
    "wac": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "ts-node src/cli/index.ts",
    "api": "ts-node src/api/server.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "webhook": "ts-node src/webhooks/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.4",
    "bullmq": "^5.12.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "inquirer": "^8.2.6",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.15",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
