// Prisma schema for the WhatsApp API Reseller Console Platform.
// Dev datasource: SQLite (file). Prod: swap provider to "postgresql" + DATABASE_URL.
// All secret fields (*Encrypted) hold ciphertext produced by src/lib/crypto.ts (AES-256-GCM).
// Never store plaintext tokens/secrets here.
//
// NOTE on status/enum columns: Prisma's SQLite connector does not support `enum` at all, so
// every "enum-like" column below is a plain String with the allowed values documented in a
// comment and enforced in the app layer via the literal types + zod schemas in
// src/types/enums.ts. Keep both in sync when adding a new status value.

generator client {
  provider = "prisma-client-js"
}

// Prisma requires the datasource `provider` to be a literal, not env() — it cannot be
// switched at runtime. For production on PostgreSQL, change this to `provider = "postgresql"`,
// set DATABASE_URL to a postgres connection string, and run `prisma migrate dev` again
// (SQLite and Postgres migrations are not interchangeable; regenerate migrations on switch).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Core actors ----------

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("admins")
}

model Client {
  id          String   @id @default(cuid())
  name        String
  companyName String?
  email       String   @unique
  phone       String?
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED — see ClientStatus in src/types/enums.ts
  // Client portal login (the customer-facing web app). Set by the admin; null = no portal access yet.
  portalPasswordHash String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  whatsappAccounts WhatsAppAccount[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  contacts         Contact[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  automationRules  AutomationRule[]

  @@map("clients")
}

// ---------- WhatsApp provisioning ----------

model WhatsAppAccount {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  provider String @default("CLOUD_API") // CLOUD_API | MOCK — see WhatsAppProviderType in src/types/enums.ts

  // Meta WhatsApp Cloud API identifiers (see WhatsAppProvider interface for version notes).
  wabaId             String
  phoneNumberId      String  @unique
  displayPhoneNumber String?
  verifiedName       String?

  // Encrypted secrets — ciphertext only.
  accessTokenEncrypted        String
  webhookVerifyTokenEncrypted String
  appSecretEncrypted          String?

  status            String    @default("PENDING") // PENDING | ACTIVE | SUSPENDED | DEPROVISIONED — see AccountStatus
  healthStatus      String    @default("UNKNOWN") // UNKNOWN | HEALTHY | UNHEALTHY — see HealthStatus
  lastHealthCheckAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions   Subscription[]
  usageRecords    UsageRecord[]
  messages        Message[]
  templates       Template[]
  contacts        Contact[]
  automationRules AutomationRule[]

  @@map("whatsapp_accounts")
}

// ---------- Automation (client self-serve auto-replies) ----------

model AutomationRule {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // null = applies to all the client's accounts; else scoped to one account.
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id])

  type     String  // WELCOME | KEYWORD | AWAY | OPT_OUT | AI — see AutomationType in src/types/enums.ts
  enabled  Boolean @default(true)
  priority Int     @default(100) // lower runs first
  configJson String @default("{}") // type-specific config (keywords, message, businessHours, systemPrompt, model…)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("automation_rules")
}

// ---------- Billing ----------

model Plan {
  id                  String   @id @default(cuid())
  name                String   @unique
  priceCents          Int
  currency            String   @default("USD")
  messageQuota        Int
  rateLimitPerSecond  Int      @default(10)
  maxWhatsAppAccounts Int      @default(1)
  featureFlagsJson    String   @default("{}")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id])

  // Primary account this subscription meters; a client can have multiple
  // accounts but billing/quota is tracked per subscription-account pair.
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id])

  status      String    @default("ACTIVE") // ACTIVE | PAST_DUE | SUSPENDED | CANCELLED — see SubscriptionStatus
  startDate   DateTime  @default(now())
  renewalDate DateTime
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoices     Invoice[]
  usageRecords UsageRecord[]

  @@map("subscriptions")
}

model Invoice {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id])

  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  currency    String    @default("USD")
  status      String    @default("DRAFT") // DRAFT | ISSUED | PAID | OVERDUE | VOID — see InvoiceStatus
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String    @default("USD")
  method      String // e.g. "manual", "stripe", "razorpay"
  provider    String // PaymentProvider implementation key
  status      String    @default("PENDING") // PENDING | SUCCEEDED | FAILED | REFUNDED — see PaymentStatus
  reference   String? // external transaction id / note
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@map("payments")
}

model UsageRecord {
  id                String          @id @default(cuid())
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id])

  cycleStart       DateTime
  cycleEnd         DateTime
  messagesSent     Int      @default(0)
  messagesReceived Int      @default(0)
  overageFlag      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([whatsappAccountId, cycleStart])
  @@map("usage_records")
}

// ---------- Messaging ----------

model Message {
  id                String          @id @default(cuid())
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  direction   String // INBOUND | OUTBOUND — see MessageDirection in src/types/enums.ts
  waMessageId String?           @unique // Meta's wamid, null until acked for outbound
  fromNumber  String
  toNumber    String
  type        String // text | image | video | document | audio | location | contacts | interactive | template
  contentJson String // raw payload (sanitized) for replay/audit
  status      String  @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED — see MessageStatus
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([whatsappAccountId, createdAt])
  @@map("messages")
}

model Template {
  id                String          @id @default(cuid())
  whatsappAccountId String
  whatsappAccount   WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  name           String
  language       String
  category       String // MARKETING | UTILITY | AUTHENTICATION (Meta categories)
  status         String  @default("PENDING") // PENDING | APPROVED | REJECTED | DISABLED — see TemplateStatus
  bodyJson       String // component structure as submitted to Meta
  metaTemplateId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([whatsappAccountId, name, language])
  @@map("templates")
}

// ---------- Audience ----------

model Contact {
  id                String           @id @default(cuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  whatsappAccountId String?
  whatsappAccount   WhatsAppAccount? @relation(fields: [whatsappAccountId], references: [id])

  phoneNumber String
  name        String?
  optInStatus String    @default("UNKNOWN") // UNKNOWN | OPTED_IN | OPTED_OUT — see OptInStatus
  optInAt     DateTime?
  optOutAt    DateTime?
  tagsJson    String    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, phoneNumber])
  @@map("contacts")
}

// ---------- Public API access ----------

model ApiKey {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  prefix     String // first chars shown in CLI/UI, e.g. "wac_live_ab12"
  keyHash    String // sha256 of the full secret key — never store plaintext
  scopesJson String    @default("[\"*\"]")
  status     String    @default("ACTIVE") // ACTIVE | REVOKED — see ApiKeyStatus
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("api_keys")
}

model WebhookEndpoint {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  url        String
  secret     String // used to sign outbound payloads (HMAC) to the CRM
  eventsJson String @default("[\"*\"]") // e.g. message.inbound, message.status, account.suspended
  status     String @default("ACTIVE") // ACTIVE | DISABLED — see WebhookEndpointStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhook_endpoints")
}

// ---------- Audit ----------

model AuditLog {
  id        String @id @default(cuid())
  actorType String // "admin" | "api_key" | "system"
  actorId   String?
  adminId   String?
  admin     Admin?  @relation(fields: [adminId], references: [id])

  action       String // e.g. "client.create", "account.suspend"
  targetType   String?
  targetId     String?
  metadataJson String  @default("{}")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_log")
}
